# Auto-detect text files and normalize line endings
* text=auto

# Source code files
*.c text eol=lf
*.h text eol=lf
*.py text eol=lf
*.json text eol=lf
*.md text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf

# Windows scripts
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Linux/Unix shell scripts
*.sh text eol=lf

# Binary files
*.dll binary
*.sys binary
*.exe binary
*.db binary
*.ico binary
*.png binary
*.jpg binary
